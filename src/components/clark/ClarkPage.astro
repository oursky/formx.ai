---
// Renders one of the standalone Clark pages (src/clark/*.html) exactly as
// approved: its own <head> content (CSS, fonts), <template> and scripts are
// output untouched. The site's main CSS is deliberately NOT loaded here, so
// the design is not affected. Added on top: favicon, site analytics, cookie
// banner, the site's SEO tags (canonical, Open Graph, Twitter) and the booking
// form hook-up to Netlify Forms.
import Analytics from '@/components/head/Analytics.astro';
import CookieConsent from '@/components/head/CookieConsent.astro';
import SEO from '@/components/head/SEO.astro';
import FontLoader from '@/components/head/FontLoader.astro';
import ClarkSiteFooter from '@/components/clark/ClarkSiteFooter.astro';
import { prerenderClarkPage } from '@/lib/clark-prerender';
import { toAbsoluteUrl } from '@/lib/constants';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  html: string;
}

const { html } = Astro.props;

// Only <html lang> is carried over and <body> is output bare, so refuse any
// other attributes rather than silently dropping them from the approved design.
const htmlAttrs = html.match(/<html([^>]*)>/i)?.[1] ?? '';
if (htmlAttrs.replace(/\slang="[^"]*"/i, '').trim()) throw new Error(`ClarkPage: unsupported <html> attributes: ${htmlAttrs.trim()}`);
const bodyAttrs = html.match(/<body([^>]*)>/i)?.[1] ?? '';
if (bodyAttrs.trim()) throw new Error(`ClarkPage: unsupported <body> attributes: ${bodyAttrs.trim()}`);

const lang = htmlAttrs.match(/\slang="([^"]+)"/i)?.[1] ?? 'en';
const rawHead = html.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1];
const rawBody = html.match(/<body[^>]*>([\s\S]*)<\/body>/i)?.[1];
if (!rawHead || !rawBody) throw new Error('ClarkPage: could not find <head> or <body> in the page HTML');

// Title and description come from the page's own <head>; SEO.astro outputs
// them again together with the canonical and social-sharing tags.
const TITLE_RE = /<title>([\s\S]*?)<\/title>/i;
const DESC_RE = /<meta\s+name="description"\s+content="([^"]*)"\s*\/?>/i;
const title = rawHead.match(TITLE_RE)?.[1]?.trim();
const description = rawHead.match(DESC_RE)?.[1];
if (!title || !description) throw new Error('ClarkPage: page <head> needs a <title> and <meta name="description">');
const decode = (s: string) => s.replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
const head = rawHead.replace(TITLE_RE, '').replace(DESC_RE, '');

// Link preview images (public/images/clark/og/): a horizontal one (also used
// by SEO.astro for og:image and twitter:image) and a square one, per page.
const slug = Astro.url.pathname.replace(/^\/clark\/?/, '').replace(/\/$/, '') || 'index';
const ogImage = (shape: 'horizontal' | 'square') => toAbsoluteUrl(`/images/clark/og/clark-${slug}-${shape}.jpg`);
const OG_IMAGES_DIR = path.join(process.cwd(), 'public/images/clark/og');
for (const shape of ['horizontal', 'square'] as const) {
  if (!fs.existsSync(path.join(OG_IMAGES_DIR, `clark-${slug}-${shape}.jpg`))) throw new Error(`ClarkPage: missing link preview image clark-${slug}-${shape}.jpg`);
}

// Put the page's first render into <div id="page"> so crawlers that don't run
// JavaScript can read the text. clark-runtime.js replaces it with the same
// content on load. See src/lib/clark-prerender.ts.
// The snapshot is taken at phone width, so it is kept invisible (but in the
// HTML for crawlers): otherwise desktop visitors could glimpse the phone
// layout before clark-runtime.js swaps in the real one.
const PAGE_DIV = '<div id="page"></div>';
if (rawBody.split(PAGE_DIV).length !== 2) throw new Error('ClarkPage: expected exactly one <div id="page"></div>');
const firstRender = await prerenderClarkPage(html);
const body = rawBody.replace(PAGE_DIV, () => `<div id="page"><div data-clark-prerender style="visibility:hidden">${firstRender}</div></div>`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Fragment set:html={head} />
    <SEO title={decode(title)} description={decode(description)} ogImage={ogImage('horizontal')} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="FormX.ai Clark" />
    <meta property="og:image" content={ogImage('square')} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="2400" />
    <meta property="og:image:alt" content="FormX.ai Clark" />
    <meta property="og:site_name" content="FormX.ai" />
    <FontLoader />
    <link href="/images/ui/Favicon_32x32.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/ui/Favicon_256x256.png" rel="apple-touch-icon" />
    <Analytics />
    <CookieConsent />
  </head>
  <body>
    <Fragment set:html={body} />
    <ClarkSiteFooter />

    <!--
      Declares the "clark-demo" form for Netlify Forms. Netlify only detects forms
      in the built HTML, and the visible form lives inside the page <template>,
      so this hidden copy lists every field Netlify should store.
      /js/clark-form.js sends the visible form's entries under this name.

      reCAPTCHA (same as the site's other demo forms, PR #24): Netlify replaces
      the data-netlify-recaptcha div with Google's widget at deploy time, and
      clark-form.js shows that widget inside the visible form.
    -->
    <form name="clark-demo" method="post" netlify netlify-honeypot="bot-field" data-netlify-recaptcha="true" hidden>
      <input type="hidden" name="form-name" value="clark-demo" />
      <input type="text" name="name" />
      <input type="email" name="email" />
      <input type="text" name="company" />
      <input type="text" name="team" />
      <input type="text" name="page" />
      <input type="text" name="bot-field" />
      {
        import.meta.env.DEV ? (
          // Local preview only: Netlify doesn't run locally, so stand in for its
          // deploy-time markup using Google's public test key (always passes).
          <div>
            <script is:inline src="https://www.google.com/recaptcha/api.js"></script>
            <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
          </div>
        ) : (
          <div data-netlify-recaptcha="true"></div>
        )
      }
    </form>
    <script is:inline src="/js/clark-form.js"></script>
  </body>
</html>
