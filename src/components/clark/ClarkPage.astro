---
// Renders one of the standalone Clark pages (src/clark/*.html) exactly as
// approved: its own <head> content (CSS, fonts), <template> and scripts are
// output untouched. The site's main CSS is deliberately NOT loaded here, so
// the design is not affected. Added on top: favicon, site analytics, cookie
// banner, and the booking form hook-up to Netlify Forms.
import Analytics from '@/components/head/Analytics.astro';
import CookieConsent from '@/components/head/CookieConsent.astro';
import { prerenderClarkPage } from '@/lib/clark-prerender';

interface Props {
  html: string;
}

const { html } = Astro.props;
const lang = html.match(/<html[^>]*\slang="([^"]+)"/i)?.[1] ?? 'en';
const head = html.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1];
const rawBody = html.match(/<body[^>]*>([\s\S]*)<\/body>/i)?.[1];
if (!head || !rawBody) throw new Error('ClarkPage: could not find <head> or <body> in the page HTML');

// Put the page's first render into <div id="page"> so crawlers that don't run
// JavaScript can read the text. clark-runtime.js replaces it with the same
// content on load. See src/lib/clark-prerender.ts.
const PAGE_DIV = '<div id="page"></div>';
if (rawBody.split(PAGE_DIV).length !== 2) throw new Error('ClarkPage: expected exactly one <div id="page"></div>');
const firstRender = await prerenderClarkPage(html);
const body = rawBody.replace(PAGE_DIV, () => `<div id="page">${firstRender}</div>`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <Fragment set:html={head} />
    <link href="/images/ui/Favicon_32x32.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/ui/Favicon_256x256.png" rel="apple-touch-icon" />
    <Analytics />
    <CookieConsent />
  </head>
  <body>
    <Fragment set:html={body} />

    <!--
      Declares the "clark-demo" form for Netlify Forms. Netlify only detects forms
      in the built HTML, and the visible form lives inside the page <template>,
      so this hidden copy lists every field Netlify should store.
      /js/clark-form.js sends the visible form's entries under this name.

      reCAPTCHA (same as the site's other demo forms, PR #24): Netlify replaces
      the data-netlify-recaptcha div with Google's widget at deploy time, and
      clark-form.js shows that widget inside the visible form.
    -->
    <form name="clark-demo" method="post" netlify netlify-honeypot="bot-field" data-netlify-recaptcha="true" hidden>
      <input type="hidden" name="form-name" value="clark-demo" />
      <input type="text" name="name" />
      <input type="email" name="email" />
      <input type="text" name="company" />
      <input type="text" name="team" />
      <input type="text" name="page" />
      <input type="text" name="bot-field" />
      {
        import.meta.env.DEV ? (
          // Local preview only: Netlify doesn't run locally, so stand in for its
          // deploy-time markup using Google's public test key (always passes).
          <div>
            <script is:inline src="https://www.google.com/recaptcha/api.js"></script>
            <div class="g-recaptcha" data-sitekey="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"></div>
          </div>
        ) : (
          <div data-netlify-recaptcha="true"></div>
        )
      }
    </form>
    <script is:inline src="/js/clark-form.js"></script>
  </body>
</html>
