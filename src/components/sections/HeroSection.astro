---
interface CtaButton {
  text: string;
  href: string;
}

interface HeroImage {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  srcset?: string;
  sizes?: string;
}

interface Props {
  tag?: string;
  tagClass?: string;
  heading: string;
  subheading?: string;
  ctaPrimary?: CtaButton;
  ctaSecondary?: CtaButton;
  ctaPrimaryClass?: string;
  image?: HeroImage;
  bgClass?: string;
  showTrustIcons?: boolean;
  headingClass?: string;
  subheadingClass?: string;
  centered?: boolean;
}

const {
  tag,
  tagClass = 'product-hero-title paragraph-small',
  heading,
  subheading,
  ctaPrimary,
  ctaSecondary,
  ctaPrimaryClass = 'gray',
  image,
  bgClass = '',
  showTrustIcons = false,
  headingClass = 'product-hero-content-heading',
  subheadingClass = 'product-hero-content-subheading',
  centered = false,
} = Astro.props;
---

<div class={`section product-hero ${bgClass}`.trim()}>
  <div class="container-default w-container min-w-0 max-w-full">
    <div class="product-hero-wrapper min-w-0">
      <div class={`hero-content-block${centered ? ' hero-content-block-centered' : ''}`}>
        <div class="product-hero-content-wrapper">
          {tag && <div class={tagClass}>{tag}</div>}
          <h1 class={headingClass}>{heading}</h1>
          {subheading && <div class={subheadingClass}>{subheading}</div>}
          {(ctaPrimary || ctaSecondary) && (
            <div class="w-layout-hflex action-buttons">
              {ctaPrimary && (
                <a href={ctaPrimary.href} class={`button-primary button-left ${ctaPrimaryClass} w-button`}>
                  {ctaPrimary.text}
                </a>
              )}
              {ctaSecondary && (
                <a href={ctaSecondary.href} class="button-primary button-left button-primary-shadow button-gradient w-button">
                  {ctaSecondary.text}
                </a>
              )}
            </div>
          )}
          {showTrustIcons && (
            <div class="w-layout-hflex icons">
              <div class="w-layout-hflex flex-block-27">
                <img src="/images/pages/solutions-hero-bannericon-free.svg" loading="lazy" alt="" class="img-icon" />
                <div>100 free pages</div>
              </div>
              <div class="w-layout-hflex flex-block-27">
                <img src="/images/pages/solutions-hero-bannericon-creditcard.svg" loading="lazy" alt="" class="img-icon" />
                <div>No credit card</div>
              </div>
              <div class="w-layout-hflex flex-block-27">
                <img src="/images/pages/solutions-hero-bannericon-lock.svg" loading="lazy" alt="" class="img-icon" />
                <div>100% secured</div>
              </div>
            </div>
          )}
        </div>
      </div>
      {image && (
        <div class="hero-image-block min-w-0">
          <img
            src={image.src}
            loading="lazy"
            width={image.width}
            height={image.height}
            alt={image.alt}
            srcset={image.srcset}
            sizes={image.sizes}
            class="image-7 img-fluid-block"
          />
        </div>
      )}
    </div>
  </div>
</div>

<style>
  /* Centered variant for heroes without an image (default layout reserves 50% width for one) */
  .hero-content-block-centered {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-content-block-centered .product-hero-content-wrapper {
    align-items: center;
    text-align: center;
    width: 100%;
  }
  /* .action-buttons is a 2-column grid; a lone button lands in the left cell */
  .hero-content-block-centered .action-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: center;
  }
  .hero-content-block-centered .icons {
    justify-content: center;
  }
</style>
